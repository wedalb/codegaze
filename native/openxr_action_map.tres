[gd_resource type="OpenXRActionMap" load_steps=5 format=3]

[sub_resource type="OpenXRAction" id="eye_action"]
resource_name = "eye_pose"
localized_name = "Eye gaze pose"
action_type = 3
toplevel_paths = PackedStringArray("/user/eyes_ext")

[sub_resource type="OpenXRActionSet" id="gaze_set"]
resource_name = "codegaze"
localized_name = "CodeGaze tracking"
actions = [SubResource("eye_action")]

[sub_resource type="OpenXRIPBinding" id="eye_binding"]
action = SubResource("eye_action")
paths = PackedStringArray("/user/eyes_ext/input/gaze_ext/pose")

[sub_resource type="OpenXRInteractionProfile" id="eye_profile"]
interaction_profile_path = "/interaction_profiles/ext/eye_gaze_interaction"
bindings = [SubResource("eye_binding")]

[resource]
action_sets = [SubResource("gaze_set")]
interaction_profiles = [SubResource("eye_profile")]
